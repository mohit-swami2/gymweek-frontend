{
  "name": "gymweek-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "node scripts/generate-landing-pngs.mjs && vite build",
    "build:pages": "vite build",
    "preview": "vite preview",
    "generate:assets": "node scripts/generate-landing-pngs.mjs",
    "test:cloudflare": "node scripts/verify-cloudflare-build.mjs",
    "test:cloudflare:full": "npm run build && npm run test:cloudflare",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name=gymweek-front"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "axios": "^1.7.9",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.34.5",
    "vite": "^6.0.6",
    "wrangler": "^4.100.0"
  }
}
